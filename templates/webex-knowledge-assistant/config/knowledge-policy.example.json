      "citable": true,
      "requires_review": true
    },
    "approved": {
      "answerable": true,
      "citable": true,
      "requires_review": true
    },
    "restricted-audit": {
      "answerable": false,
      "citable": false,
      "requires_review": true
    },
    "candidate": {
      "answerable": false,
      "citable": false,
      "requires_review": true
    },
    "synthetic": {
      "answerable": true,
      "citable": true,
      "requires_review": false
    }
